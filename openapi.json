{
  "openapi": "3.0.3",
  "info": {
    "title": "SIMPRESMA REST API",
    "description": "API Backend Sistem Informasi Manajemen Prestasi Mahasiswa (SIMPRESMA) berbasis Laravel 11 & Sanctum.\n\n### Authentication\nAuthentication menggunakan Bearer Token dari Laravel Sanctum. Header yang wajib dikirimkan:\n`Authorization: Bearer <token>`\n`Accept: application/json`",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Autentikasi & Profil Pengguna" },
    { "name": "Ref", "description": "Data Referensi & Lookup Form" },
    { "name": "Mahasiswa", "description": "Modul Pengajuan Prestasi oleh Mahasiswa" },
    { "name": "Verifikator", "description": "Modul Verifikasi Pengajuan oleh Dosen Verifikator" },
    { "name": "Tendik", "description": "Modul Finalisasi Konversi Nilai oleh Staf Tendik" },
    { "name": "Wadek", "description": "Modul Konfigurasi Matriks, Tim Verifikator, dan Mapping Bidang oleh Wadek" },
    { "name": "Shared", "description": "Dashboard Statistik & Direktori Verifikator (Semua Role)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum Token"
      }
    },
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "OK" },
          "data": { "type": "object" }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "The given data was invalid." },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": { "type": "integer", "example": 1 },
          "last_page": { "type": "integer", "example": 5 },
          "per_page": { "type": "integer", "example": 15 },
          "total": { "type": "integer", "example": 68 }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "nim_nip": { "type": "string", "example": "220210101001" },
          "nama": { "type": "string", "example": "Mahasiswa SI" },
          "email": { "type": "string", "example": "mhs.si@test.com" },
          "no_whatsapp": { "type": "string", "example": "08111110001" },
          "prodi": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 1 },
              "kode": { "type": "string", "example": "24" },
              "singkatan": { "type": "string", "example": "SI" },
              "nama": { "type": "string", "example": "Sistem Informasi" }
            }
          },
          "roles": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["mahasiswa"]
          }
        }
      },
      "Pengajuan": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "user_id": { "type": "integer", "example": 1 },
          "prodi_id": { "type": "integer", "example": 1 },
          "nama_tim": { "type": "string", "nullable": true, "example": "Tim Gemastik SI" },
          "no_whatsapp": { "type": "string", "example": "081234567890" },
          "nama_lomba": { "type": "string", "example": "Gemastik XVII 2026" },
          "bidang_id": { "type": "integer", "example": 6 },
          "tingkatan_id": { "type": "integer", "example": 1 },
          "tahapan_id": { "type": "integer", "example": 2 },
          "detail_juara": { "type": "string", "nullable": true, "example": "Juara 3" },
          "snapshot_min_sks": { "type": "integer", "example": 2 },
          "snapshot_max_sks": { "type": "integer", "example": 3 },
          "snapshot_huruf_nilai": { "type": "string", "example": "AB" },
          "link_sertifikat": { "type": "string", "example": "https://drive.google.com/file/sertifikat.pdf" },
          "status_surat_tugas_mahasiswa": { "type": "integer", "example": 1 },
          "link_surat_tugas_mahasiswa": { "type": "string", "nullable": true, "example": "https://drive.google.com/file/st-mhs.pdf" },
          "status_surat_tugas_dosen": { "type": "integer", "example": 1 },
          "link_surat_tugas_dosen": { "type": "string", "nullable": true, "example": "https://drive.google.com/file/st-dosen.pdf" },
          "link_poster": { "type": "string", "nullable": true, "example": "https://drive.google.com/file/poster.jpg" },
          "link_sosmed": { "type": "string", "nullable": true, "example": "https://instagram.com/p/gemastik" },
          "keterangan": { "type": "string", "nullable": true, "example": "Pengajuan konversi SKS" },
          "status": { "type": "string", "enum": ["pending", "diterima", "ditolak", "selesai"], "example": "pending" },
          "feedback_verifikator": { "type": "string", "nullable": true, "example": null },
          "verifikator_id": { "type": "integer", "nullable": true, "example": null },
          "verified_at": { "type": "string", "format": "date-time", "nullable": true, "example": null },
          "link_sk_konversi": { "type": "string", "nullable": true, "example": null },
          "tendik_id": { "type": "integer", "nullable": true, "example": null },
          "processed_at": { "type": "string", "format": "date-time", "nullable": true, "example": null }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login Pengguna",
        "description": "Autentikasi dengan email & password. Mengembalikan token Sanctum dan data user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "mhs.si@test.com" },
                  "password": { "type": "string", "example": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Login berhasil." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": { "type": "string", "example": "1|sanctum_token_string..." },
                        "user": { "$ref": "#/components/schemas/User" }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/422" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Logout Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Logout berhasil." },
                    "data": { "type": "null", "example": null }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/401" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Profil User Aktif",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "OK" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/401" }
        }
      }
    },
    "/ref/prodi": {
      "get": {
        "tags": ["Ref"],
        "summary": "Master Program Studi",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar Prodi" }
        }
      }
    },
    "/ref/tingkatan": {
      "get": {
        "tags": ["Ref"],
        "summary": "Master Tingkatan Lomba",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar 6 Tingkatan Lomba" }
        }
      }
    },
    "/ref/tahapan": {
      "get": {
        "tags": ["Ref"],
        "summary": "Master Tahapan Lomba",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar 4 Tahapan Lomba" }
        }
      }
    },
    "/ref/bidang": {
      "get": {
        "tags": ["Ref"],
        "summary": "Master Bidang Lomba",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar 18 Bidang Lomba Aktif" }
        }
      }
    },
    "/ref/matriks": {
      "get": {
        "tags": ["Ref"],
        "summary": "Lookup Matriks Konversi",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "tingkatan_id", "in": "query", "required": true, "schema": { "type": "integer" } },
          { "name": "tahapan_id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Batas SKS & Nilai Matriks" }
        }
      }
    },
    "/ref/mata-kuliah": {
      "get": {
        "tags": ["Ref"],
        "summary": "Lookup Mata Kuliah",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "bidang_id", "in": "query", "required": true, "schema": { "type": "integer" } },
          { "name": "prodi_id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Daftar Mata Kuliah per Bidang & Prodi" }
        }
      }
    },
    "/mahasiswa/pengajuan": {
      "get": {
        "tags": ["Mahasiswa"],
        "summary": "List Pengajuan Mahasiswa",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": { "description": "Riwayat Pengajuan Mahasiswa Login" }
        }
      },
      "post": {
        "tags": ["Mahasiswa"],
        "summary": "Submit Pengajuan Prestasi",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "no_whatsapp",
                  "nama_lomba",
                  "bidang_id",
                  "tingkatan_id",
                  "tahapan_id",
                  "mata_kuliah_ids",
                  "link_sertifikat",
                  "status_surat_tugas_mahasiswa",
                  "status_surat_tugas_dosen"
                ],
                "properties": {
                  "nama_tim": { "type": "string", "nullable": true },
                  "no_whatsapp": { "type": "string", "example": "081234567890" },
                  "nama_lomba": { "type": "string", "example": "Gemastik XVII 2026" },
                  "bidang_id": { "type": "integer", "example": 6 },
                  "tingkatan_id": { "type": "integer", "example": 1 },
                  "tahapan_id": { "type": "integer", "example": 2 },
                  "detail_juara": { "type": "string", "nullable": true, "example": "Juara 3" },
                  "mata_kuliah_ids": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "example": [1]
                  },
                  "link_sertifikat": { "type": "string", "example": "https://drive.google.com/file/sertifikat.pdf" },
                  "status_surat_tugas_mahasiswa": { "type": "integer", "enum": [0, 1], "example": 1 },
                  "link_surat_tugas_mahasiswa": { "type": "string", "nullable": true, "example": "https://drive.google.com/file/st-mhs.pdf" },
                  "status_surat_tugas_dosen": { "type": "integer", "enum": [0, 1], "example": 1 },
                  "link_surat_tugas_dosen": { "type": "string", "nullable": true, "example": "https://drive.google.com/file/st-dosen.pdf" },
                  "link_poster": { "type": "string", "nullable": true, "example": "https://drive.google.com/file/poster.jpg" },
                  "link_sosmed": { "type": "string", "nullable": true, "example": "https://instagram.com/p/gemastik" },
                  "keterangan": { "type": "string", "nullable": true, "example": "Konversi SKS lomba" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Pengajuan Berhasil Disubmit" },
          "422": { "$ref": "#/components/responses/422" }
        }
      }
    },
    "/mahasiswa/pengajuan/{id}": {
      "get": {
        "tags": ["Mahasiswa"],
        "summary": "Detail Pengajuan Milik Sendiri",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detail Pengajuan" },
          "403": { "description": "Forbidden (Bukan pemilik pengajuan)" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/verifikator/pengajuan": {
      "get": {
        "tags": ["Verifikator"],
        "summary": "List Pengajuan Pending Scope Prodi",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": { "description": "Daftar Pengajuan Pending Sesuai Scope Prodi Verifikator" }
        }
      }
    },
    "/verifikator/pengajuan/{id}": {
      "get": {
        "tags": ["Verifikator"],
        "summary": "Detail Pengajuan untuk Verifikasi",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detail Dokumen Pengajuan" },
          "403": { "description": "Forbidden (Di luar scope prodi verifikator)" }
        }
      }
    },
    "/verifikator/pengajuan/{id}/terima": {
      "post": {
        "tags": ["Verifikator"],
        "summary": "Terima Pengajuan Prestasi",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Pengajuan Berhasil Diterima" },
          "422": { "description": "Status bukan pending" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/verifikator/pengajuan/{id}/tolak": {
      "post": {
        "tags": ["Verifikator"],
        "summary": "Tolak Pengajuan Prestasi",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["feedback_verifikator"],
                "properties": {
                  "feedback_verifikator": { "type": "string", "example": "Alasan penolakan / catatan revisi" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pengajuan Berhasil Ditolak" },
          "422": { "description": "Feedback kosong atau status bukan pending" }
        }
      }
    },
    "/tendik/pengajuan": {
      "get": {
        "tags": ["Tendik"],
        "summary": "List Pengajuan Diterima (Semua Prodi)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": { "description": "Daftar Pengajuan Status Diterima" }
        }
      }
    },
    "/tendik/pengajuan/{id}": {
      "get": {
        "tags": ["Tendik"],
        "summary": "Detail Pengajuan untuk Finalisasi Nilai",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detail Pengajuan + Snapshot Nilai + List MK" }
        }
      }
    },
    "/tendik/pengajuan/{id}/finalisasi": {
      "post": {
        "tags": ["Tendik"],
        "summary": "Finalisasi Konversi SKS & Nilai",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nilai_per_mk"],
                "properties": {
                  "nilai_per_mk": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["mk_id", "huruf_nilai"],
                      "properties": {
                        "mk_id": { "type": "integer", "example": 1 },
                        "huruf_nilai": { "type": "string", "example": "AB" }
                      }
                    }
                  },
                  "link_sk_konversi": { "type": "string", "nullable": true, "example": "https://siakad.univ.ac.id/sk/123.pdf" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pengajuan Berhasil Difinalisasi (Status: selesai)" },
          "422": { "description": "Nilai input berbeda dari snapshot nilai matriks" }
        }
      }
    },
    "/wadek/matriks": {
      "get": {
        "tags": ["Wadek"],
        "summary": "List Semua 24 Baris Matriks",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar Seluruh Matriks Konversi" }
        }
      }
    },
    "/wadek/matriks/{id}": {
      "put": {
        "tags": ["Wadek"],
        "summary": "Update Aturan Matriks Konversi",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "min_sks": { "type": "integer", "nullable": true, "example": 3 },
                  "max_sks": { "type": "integer", "nullable": true, "example": 4 },
                  "huruf_nilai": { "type": "string", "nullable": true, "example": "A" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Matriks Berhasil Diperbarui" },
          "422": { "description": "max_sks < min_sks" }
        }
      }
    },
    "/wadek/verifikator": {
      "get": {
        "tags": ["Wadek"],
        "summary": "List Verifikator Aktif per Prodi",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Daftar Dosen Verifikator Aktif" }
        }
      },
      "post": {
        "tags": ["Wadek"],
        "summary": "Assign Dosen Verifikator ke Prodi",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id", "prodi_id"],
                "properties": {
                  "user_id": { "type": "integer", "example": 4 },
                  "prodi_id": { "type": "integer", "example": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Verifikator Berhasil Di-assign" },
          "422": { "description": "User atau Prodi tidak ditemukan" }
        }
      }
    },
    "/wadek/verifikator/{id}": {
      "delete": {
        "tags": ["Wadek"],
        "summary": "Cabut Verifikator dari Prodi",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Verifikator Berhasil Dicabut" }
        }
      }
    },
    "/wadek/bidang-mata-kuliah": {
      "get": {
        "tags": ["Wadek"],
        "summary": "List Mapping Bidang ke Mata Kuliah",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "bidang_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "prodi_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Daftar Mapping Bidang ke MK" }
        }
      },
      "post": {
        "tags": ["Wadek"],
        "summary": "Tambah Mapping Bidang ke Mata Kuliah",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["bidang_id", "mata_kuliah_id"],
                "properties": {
                  "bidang_id": { "type": "integer", "example": 6 },
                  "mata_kuliah_id": { "type": "integer", "example": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Mapping Berhasil Ditambahkan" },
          "422": { "description": "Mapping duplikat atau ID tidak valid" }
        }
      }
    },
    "/wadek/bidang-mata-kuliah/{id}": {
      "delete": {
        "tags": ["Wadek"],
        "summary": "Hapus Mapping Bidang ke Mata Kuliah",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Mapping Berhasil Dihapus" }
        }
      }
    },
    "/dashboard/statistik": {
      "get": {
        "tags": ["Shared"],
        "summary": "Statistik Pengajuan per Prodi",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Statistik Total, Persentase, dan Status Breakdown",
            "content": {
              "application/json": {
